<!--
============================================================================
【模块】App.xaml —— WPF 应用声明
============================================================================
【关键设置】ShutdownMode="OnExplicitShutdown"
  托盘程序没有任何常驻窗口，默认的“最后一个窗口关闭即退出”会导致启动即退。
  改为显式退出：只有右键菜单“退出”→ Application.Current.Shutdown() 才结束进程。
============================================================================
-->
<Application x:Class="MetrikLite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
  </Application.Resources>
</Application>
