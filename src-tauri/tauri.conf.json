{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetrikLite",
  "version": "2.0.3",
  "identifier": "com.morslee.metriklite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MetrikLite",
        "url": "index.html",
        "width": 380,
        "height": 300,
        "minWidth": 380,
        "minHeight": 300,
        "maxWidth": 380,
        "maxHeight": 470,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://api.github.com; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Codex quota in the Windows notification area",
    "longDescription": "A lightweight, local-first Windows tray utility that displays Codex quota windows and reset times.",
    "publisher": "Mors Lee",
    "copyright": "Copyright © 2026 Mors Lee",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
