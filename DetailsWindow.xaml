<Window x:Class="MetrikLite.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 配额"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True"
        Topmost="True" WindowStartupLocation="Manual"
        Focusable="True"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">
  <Border CornerRadius="12" Background="#FBFBFB" BorderBrush="#E2E2E2" BorderThickness="1"
          Padding="18,14" Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.28" />
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="Codex 配额" FontSize="13" FontWeight="Bold" Foreground="#1A1A1A" />
      <TextBlock x:Name="RefreshedText" FontSize="10.5" Foreground="#8A8A8A" Margin="0,2,0,0" />
      <Separator Margin="0,10" Background="#EDEDED" />
      <TextBlock Text="配额剩余" FontSize="11" Foreground="#8A8A8A" />
      <StackPanel x:Name="AgentsPanel" Margin="0,4,0,0" />
    </StackPanel>
  </Border>
</Window>
